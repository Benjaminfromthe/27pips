# ============================================================
# 27pips — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-super-secret-key-here

# Admin panel PIN
ADMIN_PIN=27pips2025

# Optional: custom database path (defaults to pips.db in project root)
# DATABASE_PATH=/path/to/your/pips.db

# Port (set automatically by Render/Railway — don't set manually)
# PORT=5000

# Debug mode (set to false in production)
FLASK_DEBUG=false

# ── Email / Password Reset ─────────────────────────────────
# OPTION 1 (Recommended): Resend — free tier, HTTPS API, works on all
# cloud platforms with zero port/firewall issues.
# Setup: https://resend.com → Sign up → API Keys → Create Key
#
# ⚠️  IMPORTANT — Resend domain restriction:
#   With onboarding@resend.dev as the sender, Resend only delivers to the
#   account owner's own email address (testing mode restriction).
#   To send to ANY user email, you have two options:
#
#   Option A (Permanent fix — 5 minutes):
#     1. Go to resend.com/domains → Add Domain
#     2. Add the DNS records shown (TXT + MX) to your domain registrar
#     3. Wait for verification (usually <5 min with Cloudflare)
#     4. Set MAIL_DEFAULT_SENDER=noreply@yourdomain.com
#
#   Option B (Temporary workaround — no domain needed):
#     Set RESEND_TEST_EMAIL to your own email address.
#     ALL outgoing emails will be redirected to that address regardless
#     of who the actual recipient is. Remove once domain is verified.
#
RESEND_API_KEY=re_your_api_key_here
RESEND_TEST_EMAIL=your-own-email@gmail.com
# The FROM address — must match a verified domain in Resend (Option A)
# or leave as onboarding@resend.dev for testing (Option B)
MAIL_DEFAULT_SENDER=onboarding@resend.dev

# OPTION 2 (Fallback): SMTP — used only if RESEND_API_KEY is not set.
# For Gmail: enable 2FA and generate an App Password at
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ── Flutterwave Payment ────────────────────────────────────
# Get keys from: https://dashboard.flutterwave.com/settings/apis
# STEP 1 — Test (sandbox) keys — use these first:
#   FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
#   FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
# STEP 2 — Go live: replace with live keys (remove _TEST prefix)
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key-here-X
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key-here-X
# Secret hash — set this in Flutterwave dashboard → Webhooks
# then put the SAME value here for webhook signature verification
FLW_SECRET_HASH=your-webhook-secret-hash-here
