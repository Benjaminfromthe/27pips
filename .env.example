# ============================================================
# 27pips — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-super-secret-key-here

# Admin panel PIN
ADMIN_PIN=27pips2025

# Optional: custom database path (defaults to pips.db in project root)
# DATABASE_PATH=/path/to/your/pips.db

# Port (set automatically by Render/Railway — don't set manually)
# PORT=5000

# Debug mode (set to false in production)
FLASK_DEBUG=false

# ── Email / Password Reset ─────────────────────────────────
# Configure these in Render's environment variables dashboard
# For Gmail: enable 2FA and create an App Password
# For SendGrid: use smtp.sendgrid.net port 587, username=apikey
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=noreply@27pips.com
