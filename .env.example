# ============================================================
# 27pips — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-super-secret-key-here

# Admin panel PIN
ADMIN_PIN=27pips2025

# Optional: custom database path (defaults to pips.db in project root)
# DATABASE_PATH=/path/to/your/pips.db

# Port (set automatically by Render/Railway — don't set manually)
# PORT=5000

# Debug mode (set to false in production)
FLASK_DEBUG=false

# ── Email / Password Reset ─────────────────────────────────
# OPTION 1 (Recommended): Resend — free tier, HTTPS API, works on all
# cloud platforms with zero port/firewall issues.
# Setup: https://resend.com → Sign up → API Keys → Create Key
# Also add your domain in Resend dashboard (or use onboarding@resend.dev
# for testing while your domain is being verified).
RESEND_API_KEY=re_your_api_key_here
# The FROM address must be a verified domain in your Resend account.
# For testing before domain verification, use: onboarding@resend.dev
MAIL_DEFAULT_SENDER=noreply@27pips.com

# OPTION 2 (Fallback): SMTP — used only if RESEND_API_KEY is not set.
# For Gmail: enable 2FA and generate an App Password at
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
